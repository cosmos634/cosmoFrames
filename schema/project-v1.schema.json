{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cosmos634/cosmoFrames/main/schema/project-v1.schema.json",
  "title": "CosmoFrames Project",
  "type": "object",
  "required": [
    "version",
    "resolution",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "resolution": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      },
      "additionalProperties": false
    },
    "fps": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 60,
      "default": 30
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600,
      "default": 5
    },
    "background": {
      "type": "string"
    },
    "background_gradient": {
      "$ref": "#/$defs/gradient"
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "string",
      "minLength": 1
    },
    "audio_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/audioTrack"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "gradient": {
      "type": "object",
      "required": [
        "colors"
      ],
      "properties": {
        "type": {
          "const": "linear"
        },
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      },
      "additionalProperties": false
    },
    "audioTrack": {
      "type": "object",
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "fade",
            "wipe_left",
            "wipe_right",
            "wipe_up",
            "wipe_down"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blend_mode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add",
            "overlay"
          ]
        },
        "transition_in": {
          "$ref": "#/$defs/transition"
        },
        "transition_out": {
          "$ref": "#/$defs/transition"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "additionalProperties": true
    },
    "element": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "rectangle",
            "circle",
            "polygon",
            "image"
          ]
        },
        "text": {
          "type": "string"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "fontSize": {
          "type": "number",
          "minimum": 0
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotation": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "strokeColor": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "integer",
          "minimum": 0
        },
        "bold": {
          "type": "boolean"
        },
        "anchor": {
          "enum": [
            "lt",
            "mt",
            "rt",
            "lm",
            "mm",
            "rm",
            "lb",
            "mb",
            "rb"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "blend_mode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "add",
            "overlay"
          ]
        },
        "mask": {
          "type": "object",
          "required": [
            "src"
          ],
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "invert": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "gradient": {
          "$ref": "#/$defs/gradient"
        },
        "animations": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
